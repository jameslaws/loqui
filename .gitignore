# Swift Package Manager / build output
.build/
.swiftpm/
Package.resolved

# Release artifacts (regenerated by release.sh; DMGs are large + ship-only)
build/
*.dmg
*.zip

# Signing secrets — never commit (these live in the keychain / password manager)
*.p12
*sparkle-private-key*
*private-key*

# macOS cruft
.DS_Store
**/.DS_Store
.dmgtools-venv/

# Lavish review artifacts (scratch, not source)
.lavish/

# Windows app build output
windows/target/
windows/node_modules/
windows/ui/dist/
windows/src-tauri/gen/
# The speech engine and model, downloaded by scripts/fetch-speech.mjs (too big for git)
windows/src-tauri/engine/
windows/src-tauri/models/
windows/.speech-cache/
# The screen tests in a browser (Playwright)
windows/test-results/
windows/playwright-report/
