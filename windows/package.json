{
  "name": "loqui-windows",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.speech.json",
    "start": "node scripts/start.mjs",
    "build": "tauri build --bundles nsis --config src-tauri/tauri.speech.json",
    "ui:dev": "vite ui",
    "ui:build": "vite build ui",
    "fetch:speech": "node scripts/fetch-speech.mjs",
    "build:test-audio": "tauri build --no-bundle --features test-audio --config src-tauri/tauri.speech.json",
    "check": "biome check . && tsc -p . && vitest run --project contracts && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test -p loqui-core",
    "check:changed": "node scripts/check-changed.mjs",
    "test:contracts": "cargo test -p loqui-core && vitest run --project contracts",
    "test:screens": "playwright test",
    "test:acceptance": "vitest run --project acceptance",
    "test:e2e": "vitest run --project e2e",
    "test:windows-screens": "vitest run --project windows-screens",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  }
}
