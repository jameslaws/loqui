{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loqui",
  "version": "../package.json",
  "identifier": "com.jameslaws.loqui",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm ui:dev",
    "beforeBuildCommand": "pnpm ui:build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Talk, and it's text.",
    "copyright": "James Laws. Free software under the GNU GPL v3.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5NUY3REM2REUwQTg5MTQKUldRVWlRcmV4bjFmMlpldmJjN3JvWFVUYjRVL0NGdjVCbTdaZU9mUzJWYUwwYUpCbWh6RjRoNVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
